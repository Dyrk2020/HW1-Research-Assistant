# Copy to .env and fill in. NEVER commit .env (keys stay local).
# omp-configure mirror: `omp config set`-style keys live here per-project.
# Unset everything = proxy-managed deepseek v4.1 flash + keyless Exa (zero setup).

# LLM (default: local proxy http://127.0.0.1:8787/v1 + deepseek/deepseek-v4.1-flash).
# Override only if you have your own key/endpoint:
# LLM_BASE_URL=http://127.0.0.1:8787/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek/deepseek-v4.1-flash

# Exa full API (optional — unset = keyless public MCP):
# EXA_API_KEY=

# Upload queue (optional):
# UPLOAD_CONCURRENCY=2
# PORT=4321
